// Prisma schema file for EVE Healthcare Diagnostic Booking Service

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]

  @@map("users")
}

model DiagnosticCentre {
  id        String                @id @default(uuid())
  name      String
  location  String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  offerings CentreTestOffering[]
  bookings  Booking[]

  @@map("diagnostic_centres")
}

model DiagnosticTest {
  id          String                @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  offerings   CentreTestOffering[]
  bookings    Booking[]

  @@map("diagnostic_tests")
}

model CentreTestOffering {
  id        String           @id @default(uuid())
  centreId  String
  testId    String
  price     Decimal          @db.Decimal(10, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  centre    DiagnosticCentre @relation(fields: [centreId], references: [id], onDelete: Cascade)
  test      DiagnosticTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@unique([centreId, testId])
  @@map("centre_test_offerings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

model Booking {
  id              String              @id @default(uuid())
  userId          String
  centreId        String
  testId          String
  offeringId      String?
  appointmentDate DateTime
  amount          Decimal             @db.Decimal(10, 2)
  status          BookingStatus       @default(PENDING)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  centre          DiagnosticCentre    @relation(fields: [centreId], references: [id], onDelete: Restrict)
  test            DiagnosticTest      @relation(fields: [testId], references: [id], onDelete: Restrict)
  offering        CentreTestOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  payment         Payment?

  @@index([userId])
  @@index([centreId])
  @@index([testId])
  @@map("bookings")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}
